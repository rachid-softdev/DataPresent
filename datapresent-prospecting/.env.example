# ============ datapresent-prospecting — variables requises ============

# LLM (qualification + rédaction des emails)
ANTHROPIC_API_KEY=sk-ant-...

# Recherche fiable (recommandé) : https://tavily.com — free tier 1000 req/mois.
# Si absent, le pipeline retombe sur le scraping SERP Google → Bing → DDG.
TAVILY_API_KEY=tvly-...

# Email (production) : domaine vérifié chez Resend
RESEND_API_KEY=re_...
PROSPECTING_SENDER=DataPresent <prospect@datapresent.com>

# Email (développement) : MailHog sur http://localhost:8025
# NODE_ENV=development
# SMTP_HOST=localhost
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=

# Navigateur : chemin Chrome/Edge en dev Windows (fallback auto sinon)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Webhook Resend (réponses/rebonds/plaintes) — port du serveur
PROSPECTING_WEBHOOK_PORT=8081

# URL d'opt-out RGPD (le ?email= est ajouté automatiquement)
# PROSPECTING_OPTOUT_URL=https://datapresent.com/unsubscribe

# Hôte runner (github par défaut, vps si exécuté sur serveur)
# RUNNER_HOST=github
