# ============ VPS — modèle .env.local (copier vers .env.local) ============
# Chargé par scripts/vps-prospecting.sh via `source .env.local`.

NODE_ENV=production

# Hôte runner : "vps" pour ne pas bloquer les runs GitHub Actions (RunnerLock).
RUNNER_HOST=vps

# Répertoire de données HORS du repo git : jamais de conflit avec GitHub Actions.
# Créer le répertoire avant le premier run.
PROSPECTING_DATA_DIR=/var/lib/datapresent-prospecting/data

# LLM (qualification + rédaction des emails) — Groq (https://console.groq.com)
GROQ_API_KEY=gsk_...

# Email (production) : domaine vérifié chez Resend
RESEND_API_KEY=re_...
PROSPECTING_SENDER=DataPresent <prospect@datapresent.com>

# URL d'opt-out RGPD (le ?email= est ajouté automatiquement)
PROSPECTING_OPTOUT_URL=https://datapresent.com/unsubscribe

# Navigateur : Chromium installé via apt sur le VPS
CHROME_PATH=/usr/bin/chromium

# Force les requêtes navigateur en IPv4 quand l'IP du VPS est flaggée par Google
# (page "trafic exceptionnel"). À activer si les recherches Google échouent.
# PROSPECTING_FORCE_IPV4=true